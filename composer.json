{
    "name": "crm/crm",
    "type": "project",
    "description": "CRM with Telegram Mini App",
    "authors": [
        {
            "name": "AidSoul",
            "email": "work-aidsoul@outlook.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "bacon/bacon-qr-code": "^3.1",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.50",
        "laravel/reverb": "^1.0",
        "laravel/wayfinder": "^0.1.23",
        "league/flysystem-aws-s3-v3": "^3.35",
        "nutgram/nutgram": "^4.0",
        "predis/predis": "^2.0",
        "spatie/laravel-backup": "^10.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan wayfinder:generate"
        ],
        "lint": "pint --test",
        "pint": "pint",
        "analyse": "phpstan analyse",
        "test": "php artisan test"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
